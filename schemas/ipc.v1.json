{
  "$defs": {
    "DirEntry": {
      "additionalProperties": false,
      "description": "One name in a directory. A symlink is reported as one and never followed.",
      "properties": {
        "entry": {
          "enum": [
            "file",
            "directory",
            "symlink",
            "other"
          ],
          "title": "Entry",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Size"
        }
      },
      "required": [
        "name",
        "entry",
        "size"
      ],
      "title": "DirEntry",
      "type": "object"
    },
    "DirListing": {
      "additionalProperties": false,
      "description": "The names in a directory, sorted, at most `MAX_DIR_ENTRIES`. `skipped` counts names left\nout because they hold control or format characters (they cannot be shown safely).",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/DirEntry"
          },
          "maxItems": 1000,
          "title": "Entries",
          "type": "array"
        },
        "kind": {
          "const": "dir_listing",
          "title": "Kind",
          "type": "string"
        },
        "skipped": {
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "entries",
        "truncated",
        "skipped"
      ],
      "title": "DirListing",
      "type": "object"
    },
    "Echo": {
      "additionalProperties": false,
      "description": "Send back this text. Answered with `Echoed`. A diagnostic and a test vehicle.",
      "properties": {
        "kind": {
          "const": "echo",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 1024,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Echo",
      "type": "object"
    },
    "Echoed": {
      "additionalProperties": false,
      "description": "The answer to `Echo`: the same text.",
      "properties": {
        "kind": {
          "const": "echoed",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 1024,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Echoed",
      "type": "object"
    },
    "EndTask": {
      "additionalProperties": false,
      "description": "End a task: its once and task grants are revoked, its runs stopped.",
      "properties": {
        "kind": {
          "const": "end_task",
          "title": "Kind",
          "type": "string"
        },
        "task": {
          "pattern": "^tsk_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task"
      ],
      "title": "EndTask",
      "type": "object"
    },
    "EnvPair": {
      "additionalProperties": false,
      "description": "A variable the caller sets in the sandbox. Only the broker's allowlist is accepted.",
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "EnvPair",
      "type": "object"
    },
    "ErrorCode": {
      "description": "Why a peer refused a request, or the whole connection. Part of the wire format.",
      "enum": [
        "incompatible_protocol",
        "bad_handshake",
        "protocol_violation",
        "unsupported_request",
        "too_many_requests",
        "timeout",
        "internal"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorFrame": {
      "additionalProperties": false,
      "description": "The failed answer to the request `id`, or (`id` null) the end of the connection.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^req_[0-7][0-9a-hjkmnp-tv-z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "kind": {
          "const": "error",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "code",
        "message"
      ],
      "title": "ErrorFrame",
      "type": "object"
    },
    "FileContent": {
      "additionalProperties": false,
      "description": "What was read: `size` bytes, as base64 text in `data`.",
      "properties": {
        "data": {
          "maxLength": 699052,
          "title": "Data",
          "type": "string"
        },
        "kind": {
          "const": "file_content",
          "title": "Kind",
          "type": "string"
        },
        "size": {
          "maximum": 524288,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "size",
        "data"
      ],
      "title": "FileContent",
      "type": "object"
    },
    "GrantOutcome": {
      "additionalProperties": false,
      "description": "The answer to `RequestGrant`: granted (`grant`, `scope`), already covered, or denied.\n\n`message` is fixed text that names the rule, never the path.",
      "properties": {
        "grant": {
          "anyOf": [
            {
              "pattern": "^grt_[0-7][0-9a-hjkmnp-tv-z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Grant"
        },
        "granted": {
          "title": "Granted",
          "type": "boolean"
        },
        "kind": {
          "const": "grant_outcome",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "maxLength": 300,
          "title": "Message",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "once",
                "task"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope"
        }
      },
      "required": [
        "kind",
        "granted",
        "grant",
        "scope",
        "message"
      ],
      "title": "GrantOutcome",
      "type": "object"
    },
    "Hello": {
      "additionalProperties": false,
      "description": "The handshake: the protocol version the sender speaks.",
      "properties": {
        "kind": {
          "const": "hello",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "version"
      ],
      "title": "Hello",
      "type": "object"
    },
    "ListDir": {
      "additionalProperties": false,
      "description": "List a directory under a grant of the task, named by its absolute path.",
      "properties": {
        "kind": {
          "const": "list_dir",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "run": {
          "pattern": "^run_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Run",
          "type": "string"
        },
        "task": {
          "pattern": "^tsk_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task",
        "run",
        "path"
      ],
      "title": "ListDir",
      "type": "object"
    },
    "ListWorkspace": {
      "additionalProperties": false,
      "description": "List a directory of the task's workspace (its root when `path` is null).",
      "properties": {
        "kind": {
          "const": "list_workspace",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "task": {
          "pattern": "^tsk_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task",
        "path"
      ],
      "title": "ListWorkspace",
      "type": "object"
    },
    "NetworkAccess": {
      "additionalProperties": false,
      "description": "`net.full`. Can be granted (and taints the task); the sandbox gets a network in S22.",
      "properties": {
        "kind": {
          "const": "net.full",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NetworkAccess",
      "type": "object"
    },
    "Ping": {
      "additionalProperties": false,
      "description": "Are you there? Answered with `Pong`.",
      "properties": {
        "kind": {
          "const": "ping",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Ping",
      "type": "object"
    },
    "Pong": {
      "additionalProperties": false,
      "description": "The answer to `Ping`.",
      "properties": {
        "kind": {
          "const": "pong",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Pong",
      "type": "object"
    },
    "ReadAccess": {
      "additionalProperties": false,
      "description": "`fs.read` of the file or directory at the absolute path `path`.",
      "properties": {
        "kind": {
          "const": "fs.read",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "ReadAccess",
      "type": "object"
    },
    "ReadFile": {
      "additionalProperties": false,
      "description": "Read a regular file under a grant of the task, named by its absolute path.",
      "properties": {
        "kind": {
          "const": "read_file",
          "title": "Kind",
          "type": "string"
        },
        "max_bytes": {
          "default": 524288,
          "maximum": 524288,
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "run": {
          "pattern": "^run_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Run",
          "type": "string"
        },
        "task": {
          "pattern": "^tsk_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task",
        "run",
        "path"
      ],
      "title": "ReadFile",
      "type": "object"
    },
    "ReadWorkspaceFile": {
      "additionalProperties": false,
      "description": "Read a regular file of the task's own workspace. No symlink is followed (I11).",
      "properties": {
        "kind": {
          "const": "read_workspace_file",
          "title": "Kind",
          "type": "string"
        },
        "max_bytes": {
          "default": 524288,
          "maximum": 524288,
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "task": {
          "pattern": "^tsk_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task",
        "path"
      ],
      "title": "ReadWorkspaceFile",
      "type": "object"
    },
    "Refused": {
      "additionalProperties": false,
      "description": "The broker would not: `reason` is a closed set, `message` fixed text.",
      "properties": {
        "kind": {
          "const": "refused",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "maxLength": 300,
          "title": "Message",
          "type": "string"
        },
        "reason": {
          "enum": [
            "unknown_task",
            "invalid_request",
            "denied",
            "not_granted",
            "not_found",
            "unsafe",
            "too_large",
            "busy",
            "unavailable",
            "timeout",
            "failed"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason",
        "message"
      ],
      "title": "Refused",
      "type": "object"
    },
    "RequestFrame": {
      "additionalProperties": false,
      "description": "A request: `body` is for the receiver to handle, and to answer under the same `id`.",
      "properties": {
        "body": {
          "discriminator": {
            "mapping": {
              "echo": "#/$defs/Echo",
              "end_task": "#/$defs/EndTask",
              "list_dir": "#/$defs/ListDir",
              "list_workspace": "#/$defs/ListWorkspace",
              "ping": "#/$defs/Ping",
              "read_file": "#/$defs/ReadFile",
              "read_workspace_file": "#/$defs/ReadWorkspaceFile",
              "request_grant": "#/$defs/RequestGrant",
              "revoke_grant": "#/$defs/RevokeGrant",
              "run_in_sandbox": "#/$defs/RunInSandbox",
              "start_task": "#/$defs/StartTask"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Ping"
            },
            {
              "$ref": "#/$defs/Echo"
            },
            {
              "$ref": "#/$defs/StartTask"
            },
            {
              "$ref": "#/$defs/EndTask"
            },
            {
              "$ref": "#/$defs/RequestGrant"
            },
            {
              "$ref": "#/$defs/RevokeGrant"
            },
            {
              "$ref": "#/$defs/ReadWorkspaceFile"
            },
            {
              "$ref": "#/$defs/ReadFile"
            },
            {
              "$ref": "#/$defs/ListWorkspace"
            },
            {
              "$ref": "#/$defs/ListDir"
            },
            {
              "$ref": "#/$defs/RunInSandbox"
            }
          ],
          "title": "Body"
        },
        "id": {
          "pattern": "^req_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "request",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "body"
      ],
      "title": "RequestFrame",
      "type": "object"
    },
    "RequestGrant": {
      "additionalProperties": false,
      "description": "Ask for `access` for `run` of `task`. The user decides, in a trusted prompt (I2).\n\n`reason` is model text: the broker bounds it and shows it as quoted, never as a fact.",
      "properties": {
        "access": {
          "discriminator": {
            "mapping": {
              "fs.read": "#/$defs/ReadAccess",
              "fs.write": "#/$defs/WriteAccess",
              "net.full": "#/$defs/NetworkAccess"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ReadAccess"
            },
            {
              "$ref": "#/$defs/WriteAccess"
            },
            {
              "$ref": "#/$defs/NetworkAccess"
            }
          ],
          "title": "Access"
        },
        "kind": {
          "const": "request_grant",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "title": "Reason",
          "type": "string"
        },
        "run": {
          "pattern": "^run_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Run",
          "type": "string"
        },
        "task": {
          "pattern": "^tsk_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task",
        "run",
        "access",
        "reason"
      ],
      "title": "RequestGrant",
      "type": "object"
    },
    "ResponseFrame": {
      "additionalProperties": false,
      "description": "The successful answer to the request with the same `id`.",
      "properties": {
        "body": {
          "discriminator": {
            "mapping": {
              "dir_listing": "#/$defs/DirListing",
              "echoed": "#/$defs/Echoed",
              "file_content": "#/$defs/FileContent",
              "grant_outcome": "#/$defs/GrantOutcome",
              "pong": "#/$defs/Pong",
              "refused": "#/$defs/Refused",
              "revoked": "#/$defs/Revoked",
              "run_result": "#/$defs/RunResult",
              "task_ended": "#/$defs/TaskEnded",
              "task_started": "#/$defs/TaskStarted"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Pong"
            },
            {
              "$ref": "#/$defs/Echoed"
            },
            {
              "$ref": "#/$defs/TaskStarted"
            },
            {
              "$ref": "#/$defs/TaskEnded"
            },
            {
              "$ref": "#/$defs/GrantOutcome"
            },
            {
              "$ref": "#/$defs/Revoked"
            },
            {
              "$ref": "#/$defs/FileContent"
            },
            {
              "$ref": "#/$defs/DirListing"
            },
            {
              "$ref": "#/$defs/RunResult"
            },
            {
              "$ref": "#/$defs/Refused"
            }
          ],
          "title": "Body"
        },
        "id": {
          "pattern": "^req_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "response",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "body"
      ],
      "title": "ResponseFrame",
      "type": "object"
    },
    "RevokeGrant": {
      "additionalProperties": false,
      "properties": {
        "grant": {
          "pattern": "^grt_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Grant",
          "type": "string"
        },
        "kind": {
          "const": "revoke_grant",
          "title": "Kind",
          "type": "string"
        },
        "task": {
          "pattern": "^tsk_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task",
        "grant"
      ],
      "title": "RevokeGrant",
      "type": "object"
    },
    "Revoked": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "revoked",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Revoked",
      "type": "object"
    },
    "RunInSandbox": {
      "additionalProperties": false,
      "description": "Run `command` in a sandbox of `task`: its workspace, and every read grant that applies.",
      "properties": {
        "command": {
          "items": {
            "maxLength": 32768,
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "cpu_seconds": {
          "default": 30,
          "maximum": 120,
          "minimum": 1,
          "title": "Cpu Seconds",
          "type": "integer"
        },
        "env": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EnvPair"
          },
          "maxItems": 8,
          "title": "Env",
          "type": "array"
        },
        "kind": {
          "const": "run_in_sandbox",
          "title": "Kind",
          "type": "string"
        },
        "max_output_bytes": {
          "default": 65536,
          "maximum": 262144,
          "minimum": 1,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "run": {
          "pattern": "^run_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Run",
          "type": "string"
        },
        "task": {
          "pattern": "^tsk_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Task",
          "type": "string"
        },
        "wall_seconds": {
          "default": 30,
          "maximum": 120,
          "minimum": 1,
          "title": "Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "task",
        "run",
        "command"
      ],
      "title": "RunInSandbox",
      "type": "object"
    },
    "RunResult": {
      "additionalProperties": false,
      "description": "How a run that started ended. `unenforced` names the limits this host could not apply\nand `landlock` whether Landlock confined the program: both are the launcher's own report.",
      "properties": {
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "kind": {
          "const": "run_result",
          "title": "Kind",
          "type": "string"
        },
        "landlock": {
          "enum": [
            "applied",
            "unavailable",
            "unknown"
          ],
          "title": "Landlock",
          "type": "string"
        },
        "mounted_grants": {
          "maximum": 64,
          "minimum": 0,
          "title": "Mounted Grants",
          "type": "integer"
        },
        "stderr": {
          "maxLength": 349528,
          "title": "Stderr",
          "type": "string"
        },
        "stderr_truncated": {
          "title": "Stderr Truncated",
          "type": "boolean"
        },
        "stdout": {
          "maxLength": 349528,
          "title": "Stdout",
          "type": "string"
        },
        "stdout_truncated": {
          "title": "Stdout Truncated",
          "type": "boolean"
        },
        "termination": {
          "enum": [
            "exited",
            "timed_out",
            "output_limit"
          ],
          "title": "Termination",
          "type": "string"
