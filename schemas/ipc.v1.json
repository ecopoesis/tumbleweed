{
  "$defs": {
    "AllowDecision": {
      "additionalProperties": false,
      "description": "The user allowed it, for `scope`. `picked` is what they chose in the picker (a picker prompt\nonly: the broker refuses an answer to any other prompt that holds one).",
      "properties": {
        "kind": {
          "const": "allow",
          "title": "Kind",
          "type": "string"
        },
        "picked": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Picked"
        },
        "scope": {
          "enum": [
            "once",
            "task"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "scope",
        "picked"
      ],
      "title": "AllowDecision",
      "type": "object"
    },
    "AnswerPrompt": {
      "additionalProperties": false,
      "description": "The user's decision on `prompt`.",
      "properties": {
        "decision": {
          "discriminator": {
            "mapping": {
              "allow": "#/$defs/AllowDecision",
              "deny": "#/$defs/DenyDecision"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AllowDecision"
            },
            {
              "$ref": "#/$defs/DenyDecision"
            }
          ],
          "title": "Decision"
        },
        "kind": {
          "const": "answer_prompt",
          "title": "Kind",
          "type": "string"
        },
        "prompt": {
          "pattern": "^prm_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "prompt",
        "decision"
      ],
      "title": "AnswerPrompt",
      "type": "object"
    },
    "ClosePrompt": {
      "additionalProperties": false,
      "description": "The prompt is over; take it down. Answered `PromptClosed` even if it is already gone.",
      "properties": {
        "kind": {
          "const": "close_prompt",
          "title": "Kind",
          "type": "string"
        },
        "prompt": {
          "pattern": "^prm_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "prompt"
      ],
      "title": "ClosePrompt",
      "type": "object"
    },
    "DenyDecision": {
      "additionalProperties": false,
      "description": "The user did not allow it, or nobody could be asked.",
      "properties": {
        "kind": {
          "const": "deny",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "enum": [
            "user_denied",
            "prompt_timeout"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "DenyDecision",
      "type": "object"
    },
    "DirEntry": {
      "additionalProperties": false,
      "description": "One name in a directory. A symlink is reported as one and never followed.",
      "properties": {
        "entry": {
          "enum": [
            "file",
            "directory",
            "symlink",
            "other"
          ],
          "title": "Entry",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Size"
        }
      },
      "required": [
        "name",
        "entry",
        "size"
      ],
      "title": "DirEntry",
      "type": "object"
    },
    "DirListing": {
      "additionalProperties": false,
      "description": "The names in a directory, sorted, at most `MAX_DIR_ENTRIES`. `skipped` counts names left\nout because they hold control or format characters (they cannot be shown safely).",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/DirEntry"
          },
          "maxItems": 1000,
          "title": "Entries",
          "type": "array"
        },
        "kind": {
          "const": "dir_listing",
          "title": "Kind",
          "type": "string"
        },
        "skipped": {
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "entries",
        "truncated",
        "skipped"
      ],
      "title": "DirListing",
      "type": "object"
    },
    "Echo": {
      "additionalProperties": false,
      "description": "Send back this text. Answered with `Echoed`. A diagnostic and a test vehicle.",
      "properties": {
        "kind": {
          "const": "echo",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 1024,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Echo",
      "type": "object"
    },
    "Echoed": {
      "additionalProperties": false,
      "description": "The answer to `Echo`: the same text.",
      "properties": {
        "kind": {
          "const": "echoed",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 1024,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "Echoed",
      "type": "object"
    },
    "EndTask": {
      "additionalProperties": false,
      "description": "End a task: its once and task grants are revoked, its runs stopped.",
      "properties": {
        "kind": {
          "const": "end_task",
          "title": "Kind",
          "type": "string"
        },
        "task": {
          "pattern": "^tsk_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task"
      ],
      "title": "EndTask",
      "type": "object"
    },
    "EnvPair": {
      "additionalProperties": false,
      "description": "A variable the caller sets in the sandbox. Only the broker's allowlist is accepted.",
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "EnvPair",
      "type": "object"
    },
    "ErrorCode": {
      "description": "Why a peer refused a request, or the whole connection. Part of the wire format.",
      "enum": [
        "incompatible_protocol",
        "bad_handshake",
        "protocol_violation",
        "unsupported_request",
        "too_many_requests",
        "timeout",
        "internal"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorFrame": {
      "additionalProperties": false,
      "description": "The failed answer to the request `id`, or (`id` null) the end of the connection.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^req_[0-7][0-9a-hjkmnp-tv-z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "kind": {
          "const": "error",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "code",
        "message"
      ],
      "title": "ErrorFrame",
      "type": "object"
    },
    "ExportTool": {
      "additionalProperties": false,
      "description": "The bundle of one stored version. The broker records that it was handed out.",
      "properties": {
        "kind": {
          "const": "export_tool",
          "title": "Kind",
          "type": "string"
        },
        "tool": {
          "pattern": "^tool_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Tool",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maximum": 9007199254740992,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "kind",
        "tool"
      ],
      "title": "ExportTool",
      "type": "object"
    },
    "FileContent": {
      "additionalProperties": false,
      "description": "What was read: `size` bytes, as base64 text in `data`.",
      "properties": {
        "data": {
          "maxLength": 699052,
          "title": "Data",
          "type": "string"
        },
        "kind": {
          "const": "file_content",
          "title": "Kind",
          "type": "string"
        },
        "size": {
          "maximum": 524288,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "size",
        "data"
      ],
      "title": "FileContent",
      "type": "object"
    },
    "GrantOutcome": {
      "additionalProperties": false,
      "description": "The answer to `RequestGrant`: granted (`grant`, `scope`), already covered, or denied.\n\n`message` is fixed text that names the rule, never the path.",
      "properties": {
        "grant": {
          "anyOf": [
            {
              "pattern": "^grt_[0-7][0-9a-hjkmnp-tv-z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Grant"
        },
        "granted": {
          "title": "Granted",
          "type": "boolean"
        },
        "kind": {
          "const": "grant_outcome",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "maxLength": 300,
          "title": "Message",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "once",
                "task"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope"
        }
      },
      "required": [
        "kind",
        "granted",
        "grant",
        "scope",
        "message"
      ],
      "title": "GrantOutcome",
      "type": "object"
    },
    "Hello": {
      "additionalProperties": false,
      "description": "The handshake: the protocol version the sender speaks.",
      "properties": {
        "kind": {
          "const": "hello",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "version"
      ],
      "title": "Hello",
      "type": "object"
    },
    "ImportTool": {
      "additionalProperties": false,
      "description": "Add the tool in `bundle` to the store, if the bundle is acceptable and the tool is new. It\nbrings no grant and no state (I8): the tool is granted again like any other.",
      "properties": {
        "bundle": {
          "maxLength": 410624,
          "title": "Bundle",
          "type": "string"
        },
        "kind": {
          "const": "import_tool",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "bundle"
      ],
      "title": "ImportTool",
      "type": "object"
    },
    "ListDir": {
      "additionalProperties": false,
      "description": "List a directory under a grant of the task, named by its absolute path.",
      "properties": {
        "kind": {
          "const": "list_dir",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "run": {
          "pattern": "^run_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Run",
          "type": "string"
        },
        "task": {
          "pattern": "^tsk_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task",
        "run",
        "path"
      ],
      "title": "ListDir",
      "type": "object"
    },
    "ListTools": {
      "additionalProperties": false,
      "description": "The newest version of each tool, most recently saved first; or, with `query`, the tools\nthat match it in name, description or tags, best first. The query is words, not a syntax:\npunctuation is dropped, at most eight words count, each matches as a prefix.",
      "properties": {
        "kind": {
          "const": "list_tools",
          "title": "Kind",
          "type": "string"
        },
        "limit": {
          "default": 50,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ListTools",
      "type": "object"
    },
    "ListWorkspace": {
      "additionalProperties": false,
      "description": "List a directory of the task's workspace (its root when `path` is null).",
      "properties": {
        "kind": {
          "const": "list_workspace",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "task": {
          "pattern": "^tsk_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task",
        "path"
      ],
      "title": "ListWorkspace",
      "type": "object"
    },
    "NetworkAccess": {
      "additionalProperties": false,
      "description": "`net.full`. Can be granted (and taints the task); the sandbox gets a network in S22.",
      "properties": {
        "kind": {
          "const": "net.full",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NetworkAccess",
      "type": "object"
    },
    "PickAccess": {
      "additionalProperties": false,
      "description": "`fs.read` of whatever the user picks: no path is named, the user chooses a file or a folder\nin the trusted picker (S18) and the choice is the grant. A pick is a read: never a write.",
      "properties": {
        "choose": {
          "enum": [
            "file",
            "folder"
          ],
          "title": "Choose",
          "type": "string"
        },
        "kind": {
          "const": "fs.pick",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "choose"
      ],
      "title": "PickAccess",
      "type": "object"
    },
    "Ping": {
      "additionalProperties": false,
      "description": "Are you there? Answered with `Pong`.",
      "properties": {
        "kind": {
          "const": "ping",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Ping",
      "type": "object"
    },
    "Pong": {
      "additionalProperties": false,
      "description": "The answer to `Ping`.",
      "properties": {
        "kind": {
          "const": "pong",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Pong",
      "type": "object"
    },
    "PromptAnswered": {
      "additionalProperties": false,
      "description": "The broker took the answer.",
      "properties": {
        "kind": {
          "const": "prompt_answered",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PromptAnswered",
      "type": "object"
    },
    "PromptClosed": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "prompt_closed",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PromptClosed",
      "type": "object"
    },
    "PromptShown": {
      "additionalProperties": false,
      "description": "The shell has the prompt (shown, or queued behind the one it shows).",
      "properties": {
        "kind": {
          "const": "prompt_shown",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PromptShown",
      "type": "object"
    },
    "ReadAccess": {
      "additionalProperties": false,
      "description": "`fs.read` of the file or directory at the absolute path `path`.",
      "properties": {
        "kind": {
          "const": "fs.read",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "ReadAccess",
      "type": "object"
    },
    "ReadFile": {
      "additionalProperties": false,
      "description": "Read a regular file under a grant of the task, named by its absolute path.",
      "properties": {
        "kind": {
          "const": "read_file",
          "title": "Kind",
          "type": "string"
        },
        "max_bytes": {
          "default": 524288,
          "maximum": 524288,
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "run": {
          "pattern": "^run_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Run",
          "type": "string"
        },
        "task": {
          "pattern": "^tsk_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task",
        "run",
        "path"
      ],
      "title": "ReadFile",
      "type": "object"
    },
    "ReadWorkspaceFile": {
      "additionalProperties": false,
      "description": "Read a regular file of the task's own workspace. No symlink is followed (I11).",
      "properties": {
        "kind": {
          "const": "read_workspace_file",
          "title": "Kind",
          "type": "string"
        },
        "max_bytes": {
          "default": 524288,
          "maximum": 524288,
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "task": {
          "pattern": "^tsk_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task",
        "path"
      ],
      "title": "ReadWorkspaceFile",
      "type": "object"
    },
    "Refused": {
      "additionalProperties": false,
      "description": "The broker would not: `reason` is a closed set, `message` fixed text.",
      "properties": {
        "kind": {
          "const": "refused",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "maxLength": 300,
          "title": "Message",
          "type": "string"
        },
        "reason": {
          "enum": [
            "unknown_task",
            "invalid_request",
            "denied",
            "not_granted",
            "not_found",
            "unsafe",
            "too_large",
            "busy",
            "unavailable",
            "timeout",
            "failed",
            "conflict",
            "unknown_prompt"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason",
        "message"
      ],
      "title": "Refused",
      "type": "object"
    },
    "RequestFrame": {
      "additionalProperties": false,
      "description": "A request: `body` is for the receiver to handle, and to answer under the same `id`.",
      "properties": {
        "body": {
          "discriminator": {
            "mapping": {
              "answer_prompt": "#/$defs/AnswerPrompt",
              "close_prompt": "#/$defs/ClosePrompt",
              "echo": "#/$defs/Echo",
              "end_task": "#/$defs/EndTask",
              "export_tool": "#/$defs/ExportTool",
              "import_tool": "#/$defs/ImportTool",
              "list_dir": "#/$defs/ListDir",
              "list_tools": "#/$defs/ListTools",
              "list_workspace": "#/$defs/ListWorkspace",
              "ping": "#/$defs/Ping",
              "read_file": "#/$defs/ReadFile",
              "read_workspace_file": "#/$defs/ReadWorkspaceFile",
              "request_grant": "#/$defs/RequestGrant",
              "revoke_grant": "#/$defs/RevokeGrant",
              "run_in_sandbox": "#/$defs/RunInSandbox",
              "show_prompt": "#/$defs/ShowPrompt",
              "show_tool": "#/$defs/ShowTool",
              "start_task": "#/$defs/StartTask"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Ping"
            },
            {
              "$ref": "#/$defs/Echo"
            },
            {
              "$ref": "#/$defs/StartTask"
            },
            {
              "$ref": "#/$defs/EndTask"
            },
            {
              "$ref": "#/$defs/RequestGrant"
            },
            {
              "$ref": "#/$defs/RevokeGrant"
            },
            {
              "$ref": "#/$defs/ReadWorkspaceFile"
            },
            {
              "$ref": "#/$defs/ReadFile"
            },
            {
              "$ref": "#/$defs/ListWorkspace"
            },
            {
              "$ref": "#/$defs/ListDir"
            },
            {
              "$ref": "#/$defs/RunInSandbox"
            },
            {
              "$ref": "#/$defs/ListTools"
            },
            {
              "$ref": "#/$defs/ShowTool"
            },
            {
              "$ref": "#/$defs/ExportTool"
            },
            {
              "$ref": "#/$defs/ImportTool"
            },
            {
              "$ref": "#/$defs/AnswerPrompt"
            },
            {
              "$ref": "#/$defs/ShowPrompt"
            },
            {
              "$ref": "#/$defs/ClosePrompt"
            }
          ],
          "title": "Body"
        },
        "id": {
          "pattern": "^req_[0-7][0-9a-hjkmnp-tv-z]{25}$",
          "title": "Id",
