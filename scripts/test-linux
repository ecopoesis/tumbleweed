#!/usr/bin/env bash
# Run the full check suite in the Linux container (GTK under headless weston, bubblewrap, ...).
#
#   scripts/test-linux                       format, lint, mypy, import contracts, pytest
#   scripts/test-linux uv run pytest -k foo  any other command, in the same environment
#   TUMBLEWEED_CI=1 scripts/test-linux       what CI does: a skipped gtk/linux test fails
#
# The image holds the source as of the build, so every run rebuilds it first; Docker's layer
# cache keeps that fast unless pyproject.toml or uv.lock changed.
#
# The run uses the exact image this build produced (--iidfile), never a tag: with a shared tag,
# two worktrees running this script at once could each test the other's code.
set -euo pipefail

cd "$(dirname "$0")/.."

iidfile="$(mktemp)"
trap 'rm -f "$iidfile"' EXIT
docker build --iidfile "$iidfile" .
image="$(cat "$iidfile")"

# The flags are ARCHITECTURE section 11: bubblewrap needs user namespaces and a fresh /proc,
# slirp4netns needs a tap device. Nothing else is relaxed. (Not `exec`: the trap must run.)
docker run --rm \
    --security-opt seccomp=unconfined \
    --security-opt apparmor=unconfined \
    --security-opt systempaths=unconfined \
    --device /dev/net/tun \
    --env TUMBLEWEED_CI \
    "$image" "$@"
